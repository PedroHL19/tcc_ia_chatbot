PORT=3000

# Chave obrigatória da rota POST /agente (o Blip envia no header "Authorization: Key <API_KEY>").
# Gere uma chave aleatória com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY=

OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=bge-m3

# Desempenho (opcionais)
# Tempo que os modelos ficam na memória após o último uso ("1h", "30m"); -1 = sempre carregados (sem cold start)
OLLAMA_KEEP_ALIVE=1h
# true = embeddings na CPU, liberando a GPU para o LLM (recomendado em GPUs de 4 GB)
EMBEDDING_ON_CPU=false
# Máximo de tokens por resposta (512 cobre as respostas mais longas da base)
LLM_NUM_PREDICT=512

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ifmg_estagios

# URL usada pela suíte de testes (npm run test:bot)
TEST_URL=http://localhost:3000
