<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram id="pesquisa" name="Pesquisa de satisfação"><mxGraphModel dx="1100" dy="1300" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1320"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="PESQUISA DE SATISFAÇÃO" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="340" y="35" width="420" height="55" as="geometry"/></mxCell><mxCell id="sat" value="1 · SATISFAÇÃO&#xa;&#xa;Como você avalia sua satisfação com o atendimento do Assistente Virtual do IFMG Campus Sabará?&#xa;&#xa;⭐ Muito satisfeito&#xa;🙂 Satisfeito&#xa;😐 Neutro&#xa;🙁 Insatisfeito&#xa;😞 Muito insatisfeito" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3e8ff;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="300" y="125" width="500" height="245" as="geometry"/></mxCell><mxCell id="resolve" value="2 · OBTEVE O QUE PROCURAVA?&#xa;&#xa;Você conseguiu obter a informação que procurava?&#xa;&#xa;Sim  |  Parcialmente  |  Não" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="300" y="415" width="500" height="150" as="geometry"/></mxCell><mxCell id="comment" value="3 · AGRADECIMENTO E COMENTÁRIO OPCIONAL&#xa;&#xa;Obrigado pela sua avaliação! Sua opinião nos ajuda a melhorar o Assistente Virtual do IFMG Campus Sabará.&#xa;&#xa;Tem algum comentário sobre sua experiência ou alguma sugestão de melhoria? Escreva abaixo.&#xa;&#xa;Se preferir, selecione “Pular comentário”." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="300" y="610" width="500" height="210" as="geometry"/></mxCell><mxCell id="feedback" value="Usuário envia um comentário" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="100" y="870" width="350" height="70" as="geometry"/></mxCell><mxCell id="skip" value="Usuário seleciona “Pular comentário”" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="650" y="870" width="350" height="70" as="geometry"/></mxCell><mxCell id="thanks" value="Obrigado por compartilhar! Seu comentário nos ajudará a melhorar o atendimento." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="100" y="980" width="350" height="95" as="geometry"/></mxCell><mxCell id="end" value="4 · ENCERRAMENTO&#xa;&#xa;Agradecemos pelo contato com o Assistente Virtual do IFMG Campus Sabará. Até a próxima!" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="300" y="1130" width="500" height="115" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="start" target="sat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="sat" target="resolve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="resolve" target="comment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="comment" target="feedback"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="comment" target="skip"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="feedback" target="thanks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="thanks" target="end"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="skip" target="end"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
